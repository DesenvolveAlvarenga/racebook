# =============================================================================
# RACEBOOK — variáveis de ambiente
# Copie para .env.local (desenvolvimento) e cadastre as mesmas na Vercel.
# NUNCA coloque aqui a chave service_role / secret: o app não precisa dela.
# =============================================================================

# Supabase → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Supabase → Project Settings → API Keys → Publishable key (começa com sb_publishable_)
# Projetos antigos: a chave "anon" (legacy) também funciona aqui.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Endereço público do site, sem barra no final.
# Local: http://localhost:3000 | Produção: https://seu-dominio.com.br
NEXT_PUBLIC_SITE_URL=http://localhost:3000
